# Qui reçoit quoi dépend de `profil` dans les [data] du chezmoi.toml de chaque compte :
#   complet  tout le repo (sauf le module agent)
#   agent    la liste blanche ci-dessous + le module agent
#   absent   la liste blanche seule (défaut le plus restrictif)
# Un fichier ajouté au repo n'est donc jamais partagé par défaut. Les motifs en `!`
# l'emportent sur `**`. Un dossier parent doit aussi être listé pour que son contenu passe.
{{- $profil := get . "profil" | default "restreint" }}
{{- if ne $profil "complet" }}
**
!.zshrc
!.config
!.config/zsh
!.config/zsh/50-prompt.zsh
!.config/zsh/60-eza.zsh
!.config/zsh/90-zoxide.zsh
!.config/starship.toml
!.config/zellij
!.config/zellij/config.kdl
!.config/git
!.config/git/config
!git-includes.sh
{{- if eq $profil "agent" }}
!.config/zsh/10-agent.zsh
{{- end }}
{{- else }}
.config/zsh/10-agent.zsh
{{- end }}
