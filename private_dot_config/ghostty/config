# =========================
# Thème : une seule palette pour tous les outils
# =========================
# eza, fzf (--color=16), bat (BAT_THEME=ansi), Starship et le badge du prompt
# utilisent les 16 couleurs de ce thème ; Zellij a le thème du même nom.
# Autres thèmes : ghostty +list-themes (ex. Rose Pine, Kanagawa Wave, Ayu).
theme = Catppuccin Mocha

background-opacity = 0.92

cursor-style = bar


# =========================
# Font (Warp-like)
# =========================
font-family = "JetBrainsMono Nerd Font"
font-size = 15

font-thicken = true
font-feature = -liga


# =========================
# Window (important)
# =========================

window-decoration = true
macos-titlebar-style = transparent

window-padding-x = 14
window-padding-y = 14

#renderer = metal


# =========================
# Warp-like Quick Terminal
# =========================


keybind = global:ctrl+alt+m=toggle_quick_terminal
#keybind = global:caps_lock+caps_lock=toggle_quick_terminal

quick-terminal-position = bottom
quick-terminal-animation-duration = 0
quick-terminal-size = 100%

#macos-option-as-alt = right
quick-terminal-autohide = true
quick-terminal-space-behavior = move


copy-on-select = clipboard

keybind = shift+up=scroll_page_lines:-50
keybind = shift+down=scroll_page_lines:50

