# =========================
# Thème : une seule palette pour tous les outils
# =========================
# eza, fzf (--color=16), bat (BAT_THEME=ansi), Starship et le badge du prompt
# utilisent les 16 couleurs de ce thème ; Zellij a le thème du même nom.
# Autres thèmes : ghostty +list-themes (ex. Rose Pine, Kanagawa Wave, Ayu).
theme = Catppuccin Mocha

background-opacity = 0.92

# Curseur : bloc plein jaune vif qui clignote, hors palette pastel du thème
# pour repérer d'un coup d'œil la fenêtre active (dans une fenêtre inactive,
# Ghostty le dessine en bloc creux). Le texte sous le curseur reprend le fond
# du thème pour rester lisible.
cursor-style = block
cursor-style-blink = true
cursor-color = #ffd400
cursor-text = #1e1e2e
# Sans 'no-cursor', l'intégration shell de Ghostty remet une barre au prompt,
# quel que soit cursor-style (les autres fonctions de l'intégration restent).
shell-integration-features = no-cursor


# =========================
# Font (Warp-like)
# =========================
font-family = "JetBrainsMono Nerd Font"
font-size = 15

font-thicken = true
font-feature = -liga


# =========================
# Window (important)
# =========================

window-decoration = true
macos-titlebar-style = transparent

window-padding-x = 14
window-padding-y = 14

#renderer = metal


# =========================
# Warp-like Quick Terminal
# =========================


keybind = global:ctrl+alt+m=toggle_quick_terminal
#keybind = global:caps_lock+caps_lock=toggle_quick_terminal

quick-terminal-position = bottom
quick-terminal-animation-duration = 0
quick-terminal-size = 100%

#macos-option-as-alt = right
quick-terminal-autohide = true
quick-terminal-space-behavior = move


copy-on-select = clipboard

keybind = shift+up=scroll_page_lines:-50
keybind = shift+down=scroll_page_lines:50

