# Config propre au compte agent : Homebrew (installé et possédé par belaz), outils dans
# ~/.local/bin, ssh-agent persistant avec la clé GitLab du compte de service.
# Déployée uniquement pour agent : voir .chezmoiignore.
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $b ]] && { eval "$($b shellenv)"; break; }
done
export PATH="$HOME/.local/bin:$PATH"
# Flutter/Dart : SDK courant de fvm et exécutables `dart pub global`
export PATH="$HOME/fvm/default/bin:$HOME/.pub-cache/bin:$PATH"

# fzf : Ctrl T (fichiers), Alt C (dossiers), complétion `**` ; Ctrl R passe ensuite à atuin
# (80-atuin.zsh). Couleurs du terminal, comme pour belaz (10-belaz.zsh).
export FZF_DEFAULT_OPTS='--color=16'
(( $+commands[fzf] )) && source <(fzf --zsh)

if [[ -o interactive ]]; then
    SSH_AGENT_DIR="$HOME/.ssh/agent"
    # Durée de vie (s) de l'agent et des clés chargées : [data] ssh_key_lifetime dans
    # ~/.config/chezmoi/chezmoi.toml (ex. 43200 sur mbp-intel-srv), 14400 par défaut.
    SSH_KEY_LIFETIME={{ if hasKey . "ssh_key_lifetime" }}{{ .ssh_key_lifetime }}{{ else }}14400{{ end }}
    SSH_AUTH_SOCK="$SSH_AGENT_DIR/socket"

    mkdir -p "$SSH_AGENT_DIR"
    chmod 700 "$SSH_AGENT_DIR"

    export SSH_AUTH_SOCK

    # Is there an ssh-agent listening on our persistent socket?
    if ! ssh-add -l >/dev/null 2>&1; then
        rm -f "$SSH_AUTH_SOCK"

        ssh-agent \
            -a "$SSH_AUTH_SOCK" \
            -t "$SSH_KEY_LIFETIME" \
            >/dev/null
    fi

    # Clés à déverrouiller : [data] ssh_keys dans ~/.config/chezmoi/chezmoi.toml de l'agent
    SSH_KEYS=({{ range (get . "ssh_keys" | default (list "gitlab-sa-agent")) }}{{ . | squote }} {{ end }})

    for GITLAB_KEY in "$HOME/.ssh/"${^SSH_KEYS}; do
        if [[ ! -r "$GITLAB_KEY.pub" ]]; then
            echo "Clé SSH introuvable : $GITLAB_KEY" >&2
            continue
        fi

        # Is this key loaded?
        KEY_FP="$(ssh-keygen -lf "$GITLAB_KEY.pub" | awk '{print $2}')"

        if ! ssh-add -l 2>/dev/null | grep -Fq "$KEY_FP"; then
            echo "Unlock SSH key ${GITLAB_KEY:t}:"
            ssh-add -t "$SSH_KEY_LIFETIME" "$GITLAB_KEY"
        fi
    done
fi
