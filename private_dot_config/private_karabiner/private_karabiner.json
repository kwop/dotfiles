{
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "iso" },
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock (clavier interne) : tap = ⌃⌥M, maintenu = ⌃⌥",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  { "type": "device_if", "identifiers": [{ "is_built_in_keyboard": true }] }
                ],
                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "left_control", "modifiers": ["left_option"] }],
                "to_if_alone": [{ "key_code": "semicolon", "modifiers": ["left_control", "left_option"] }],
                "parameters": { "basic.to_if_alone_timeout_milliseconds": 300 }
              }
            ]
          }
        ]
      }
    }
  ]
}
