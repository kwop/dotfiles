# Alias GitLab propres à belaz. Identité, alias communs et config par dossier :
# ~/.config/git/config (données dans chezmoi.toml).
[alias]
	mrdevelop = !$(echo git rev-parse --abbrev-ref HEAD) |  xargs -I {} git push -o merge_request.assign={{ .gitlab_username }}  -o merge_request.label=develop -o merge_request.create -o merge_request.remove_source_branch -o merge_request.target=develop --set-upstream origin  {}
	mr = !$(echo git rev-parse --abbrev-ref HEAD) |  xargs -I {} git push -o merge_request.assign={{ .gitlab_username }}  -o merge_request.label=develop -o merge_request.create -o merge_request.remove_source_branch -o merge_request.target=develop --set-upstream origin  {}
