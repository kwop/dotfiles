# ~/.zshrc, géré par chezmoi (repo kwop/dotfiles) : modifier la source, pas ce fichier.
# La config est découpée en modules dans ~/.config/zsh, chargés par ordre alphabétique.
# Chaque compte ne reçoit que ses modules : voir .chezmoiignore.
{{- if ne (get . "profil") "complet" }}

# Compte secondaire (profil ≠ complet) : resynchronise la config depuis la source de belaz avant de charger
# les modules. Non bloquant : en cas d'échec, la config déjà en place est conservée.
# chezmoi de Homebrew : /opt/homebrew sur Apple Silicon, /usr/local sur Intel.
if [[ -o interactive ]]; then
  for c in /opt/homebrew/bin/chezmoi /usr/local/bin/chezmoi; do
    [[ -x $c ]] || continue
    $c apply --force --no-tty >/dev/null 2>&1 ||
      print -u2 "chezmoi apply a échoué, config actuelle conservée (détails : chezmoi apply)"
    break
  done
  unset c
fi
{{- end }}

for f in ~/.config/zsh/*.zsh(N); do source "$f"; done
unset f
